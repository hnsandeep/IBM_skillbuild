# ──────────────────────────────────────────────────────────────────────────────
# SafeInbox AI — Backend environment variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in real values below
# 3. Never commit .env to version control
# ──────────────────────────────────────────────────────────────────────────────

# Required — OpenRouter API key
# Get your key at: https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_key_here

# Optional — Google Safe Browsing API key
# Get yours at: https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_KEY=your_google_safe_browsing_api_key_here
